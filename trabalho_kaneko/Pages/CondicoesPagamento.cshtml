@page
@model trabalho_kaneko.Pages.CondicoesPagamentoModel
@{
    ViewData["Title"] = "Nova Condição de Pagamento";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-page="/CondicoesPagamentoListar" class="btn btn-secondary btn-sm fw-bold">VOLTAR PARA A LISTA</a>
    </div>

    <div class="card shadow-sm border-success mb-5">
        <div class="card-header bg-success text-white fw-bold text-uppercase">
            <h4 class="mb-0">+ Nova Condição de Pagamento</h4>
        </div>
        <div class="card-body">
            @if (TempData["MensagemErro"] != null)
            {
                <div class="alert alert-danger fw-bold">@TempData["MensagemErro"]</div>
            }

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3 fw-bold fs-5"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold campo-obrigatorio text-uppercase text-primary">Condição</label>
                        <input asp-for="Condicao.CondicaoPagamento" class="form-control" required maxlength="50" placeholder="Ex: 15/30 Dias, À Vista..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold campo-obrigatorio text-uppercase text-primary">Qtd. Parcelas</label>
                        <input asp-for="Condicao.QuantidadeParcelas" type="number" min="1" max="120" id="inputQtdParcelas" class="form-control" required value="1" oninput="gerarParcelasDinamicas()" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold text-uppercase text-danger">Juros (%)</label>
                        <input asp-for="Condicao.Juros" type="number" step="0.01" class="form-control" value="0.00" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold text-uppercase text-warning text-dark">Multa (%)</label>
                        <input asp-for="Condicao.Multa" type="number" step="0.01" class="form-control" value="0.00" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold text-uppercase text-success">Desconto (%)</label>
                        <input asp-for="Condicao.Desconto" type="number" step="0.01" class="form-control" value="0.00" />
                    </div>
                </div>

                <!-- CONTÊINER ONDE AS PARCELAS VÃO APARECER DINAMICAMENTE -->
                <div id="containerParcelas" class="mt-4"></div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success px-5 py-2 fw-bold text-uppercase">Salvar Condição</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Gera a tabela no carregamento inicial da tela (para o caso de já vir com valor "1")
        window.onload = function() {
            gerarParcelasDinamicas();
        };

        function gerarParcelasDinamicas() {
            const qtd = parseInt(document.getElementById('inputQtdParcelas').value) || 0;
            const container = document.getElementById('containerParcelas');

            // Limpa o contêiner
            container.innerHTML = '';

            if (qtd > 0) {
                let html = '<h5 class="border-bottom pb-2 w-100 text-uppercase fw-bold text-secondary">Configuração das Parcelas</h5>';
                html += '<div class="table-responsive"><table class="table table-bordered text-center align-middle" style="max-width: 600px;">';
                html += '<thead class="table-light"><tr><th style="width: 20%;">PARCELA</th><th style="width: 40%;">DIAS (Após a compra)</th><th style="width: 40%;">PORCENTAGEM (%)</th></tr></thead><tbody>';

                // Calcula a porcentagem igualitária padrão (ex: 3 parcelas = 33.33%)
                let porcentagemPadrao = (100 / qtd).toFixed(2);

                for (let i = 1; i <= qtd; i++) {
                    // Sugere dias automaticamente (À vista = 0 dias, ou múltiplos de 30)
                    let diasSugeridos = qtd === 1 ? 0 : i * 30;

                    // NOTA: O name="Parcelas[${i - 1}].Dias" foi corrigido para o C# conseguir ler os dados como uma Lista!
                    html += `
                                <tr>
                                    <td class="fw-bold">${i}ª</td>
                                    <td>
                                        <div class="input-group">
                                            <input type="number" name="Parcelas[${i - 1}].Dias" class="form-control text-center" value="${diasSugeridos}" required min="0">
                                            <span class="input-group-text">Dias</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <input type="number" name="Parcelas[${i - 1}].Porcentagem" class="form-control text-center porcentagem-parcela" value="${porcentagemPadrao}" step="0.01" required min="0.01" max="100">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </td>
                                </tr>
                            `;
                }

                html += '</tbody></table></div>';
                container.innerHTML = html;
            }
        }
    </script>
}