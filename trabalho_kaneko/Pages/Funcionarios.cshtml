@section Scripts {
    <script>
        // Correção de Bug do Bootstrap para todos os modais aninhados
        const modals = ['modalNovoCargo', 'modalEditarCargo', 'modalNovaCidade', 'modalEditarCidade', 'modalNovoEstado', 'modalEditarEstado', 'modalNovoPais', 'modalEditarPais'];
        modals.forEach(modalId => {
            document.getElementById(modalId)?.addEventListener('hidden.bs.modal', function () {
                if (document.querySelector('.modal.show')) {
                    document.body.classList.add('modal-open');
                }
            });
        });

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const dataAtualBR = () => {
            const now = new Date();
            return now.toLocaleDateString('pt-BR') + ' ' + now.toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'});
        };

        // =========================================================
        // SCRIPTS PARA CARGOS
        // =========================================================
function salvarCargoAjax() {
            const nome = document.getElementById('modalCargoNome').value;
            const desc = document.getElementById('modalCargoDescricao').value;

            if (!nome) { alert('Preencha o nome do cargo!'); return; }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new URLSearchParams({ cargoNome: nome, descricao: desc });

            fetch('?handler=CriarCargoRapido', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }, body: formData.toString() })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) {
                    const select = document.getElementById('selectCargoPrincipal');
                    if (select) select.add(new Option(data.nome, data.id, true, true));

                    const tbody = document.querySelector('#modalNovoCargo tbody');
                    if (tbody) {
                        // ADICIONADO: A coluna extra td-cargo-descricao
                        tbody.insertAdjacentHTML('beforeend', `
                            <tr id="linha-cargo-${data.id}">
                                <td>${data.id}</td>
                                <td class="fw-bold text-uppercase" id="td-cargo-nome-${data.id}">${nome.toUpperCase()}</td>
                                <td class="text-uppercase" id="td-cargo-descricao-${data.id}">${desc.toUpperCase()}</td>
                                <td>${dataAtualBR()}</td>
                                <td id="td-cargo-alteracao-${data.id}"></td>
                                <td>
                                    <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="abrirModalEditarCargo(${data.id}, '${nome.toUpperCase()}', '${desc.toUpperCase()}')">EDITAR</button>
                                    <button type="button" class="btn btn-danger btn-sm fw-bold" onclick="excluirCargoAjax(${data.id})">EXCLUIR</button>
                                </td>
                            </tr>`);
                    }
                    document.getElementById('modalCargoNome').value = '';
                    document.getElementById('modalCargoDescricao').value = '';
                } else alert('Erro ao salvar cargo.');
            });
        }

        function abrirModalEditarCargo(id, nome, desc) {
            document.getElementById('editCargoId').value = id;
            document.getElementById('editCargoNome').value = nome;
            document.getElementById('editCargoDescricao').value = desc || '';

            var modal = new bootstrap.Modal(document.getElementById('modalEditarCargo'));
            modal.show();
            document.getElementById('modalEditarCargo').style.zIndex = '1060';
            setTimeout(() => {
                const backdrops = document.querySelectorAll('.modal-backdrop');
                if (backdrops.length > 1) backdrops[backdrops.length - 1].style.zIndex = '1059';
            }, 100);
        }

function salvarEdicaoCargoAjax() {
            const id = document.getElementById('editCargoId').value;
            const nome = document.getElementById('editCargoNome').value;
            const desc = document.getElementById('editCargoDescricao').value;

            if(!nome) { alert('Preencha o nome do cargo!'); return; }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new URLSearchParams({ id: id, cargoNome: nome, cargoDescricao: desc });

            fetch('?handler=EditarCargoRapido', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }, body: formData.toString() })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) {
                    document.getElementById('td-cargo-nome-' + id).innerText = nome.toUpperCase();
                    // ADICIONADO: Atualização em tempo real do campo de descrição
                    const tdDesc = document.getElementById('td-cargo-descricao-' + id);
                    if(tdDesc) tdDesc.innerText = desc.toUpperCase();
                    
                    document.getElementById('td-cargo-alteracao-' + id).innerText = dataAtualBR();

                    const select = document.getElementById('selectCargoPrincipal');
                    if (select) {
                        for (let i = 0; i < select.options.length; i++) {
                            if (select.options[i].value === id) { select.options[i].text = nome.toUpperCase(); break; }
                        }
                    }

                    const tr = document.getElementById('linha-cargo-' + id);
                    if(tr) {
                        const btnEdit = tr.querySelector('.btn-warning');
                        if(btnEdit) btnEdit.setAttribute('onclick', `abrirModalEditarCargo(${id}, '${nome.toUpperCase()}', '${desc.toUpperCase()}')`);
                    }

                    bootstrap.Modal.getInstance(document.getElementById('modalEditarCargo')).hide();
                } else alert(data.mensagem);
            });
        }

        function excluirCargoAjax(id) {
            if (!confirm('Tem certeza que deseja excluir este cargo?')) return;
            const formData = new URLSearchParams({ id: id });
            fetch('?handler=ExcluirCargoRapido', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }, body: formData.toString() })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) {
                    document.getElementById('linha-cargo-' + id).remove();
                    const select = document.getElementById('selectCargoPrincipal');
                    if (select) {
                        for (let i = 0; i < select.options.length; i++) {
                            if (select.options[i].value == id) { select.remove(i); break; }
                        }
                    }
                } else alert(data.mensagem);
            });
        }

