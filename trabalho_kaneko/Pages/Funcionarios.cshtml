@page
@model trabalho_kaneko.Pages.FuncionariosModel
@{
    ViewData["Title"] = "Novo Funcionário";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-page="/FuncionariosListar" class="btn btn-danger btn-sm fw-bold">Voltar para a Lista</a>
    </div>

    <div class="card shadow-sm border-success mb-5">
        <div class="card-header bg-success text-white fw-bold text-uppercase">
            <h4 class="mb-0">+ Novo Funcionário</h4>
        </div>
        <div class="card-body">
            @if (TempData["MensagemErro"] != null)
            {
                <div class="alert alert-danger fw-bold">@TempData["MensagemErro"]</div>
            }

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3 fw-bold fs-5"></div>

                <div class="row g-3">
                    <h5 class="border-bottom pb-2 w-100 text-uppercase fw-bold text-secondary">Identificação</h5>

                    <div class="col-md-6">
                        <label class="form-label fw-bold campo-obrigatorio text-uppercase">Funcionário</label>
                        <input asp-for="Funcionario.Funcionario" class="form-control" style="text-transform: uppercase;" required maxlength="50" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase">Apelido / Nome Social</label>
                        <input asp-for="Funcionario.Apelido" class="form-control" style="text-transform: uppercase;" maxlength="50" />
                    </div>

                    <h5 class="mt-4 border-bottom pb-2 w-100 text-uppercase fw-bold text-secondary">Contrato e Atribuição</h5>

                    <div class="col-md-4">
                        <label class="form-label fw-bold campo-obrigatorio text-uppercase">Cargo</label>
                        <div class="input-group flex-nowrap">
                            <select asp-for="Funcionario.IdCargo" class="form-select" id="selectCargoPrincipal" required>
                                <option value="">-- Selecione o Cargo --</option>
                                @if (Model.ListaCargos != null)
                                {
                                    foreach (var cargo in Model.ListaCargos)
                                    {
                                        <option value="@cargo.IdCargo">@cargo.Cargo</option>
                                    }
                                }
                            </select>
                            <button class="btn btn-outline-success fw-bold" type="button" data-bs-toggle="modal" data-bs-target="#modalNovoCargo">
                                + Novo
                            </button>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-uppercase">Salário (R$)</label>
                        <input asp-for="Funcionario.Salario" type="number" step="0.01" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-uppercase">Data de Admissão</label>
                        <input asp-for="Funcionario.DataContratado" type="date" class="form-control" />
                    </div>

                    <h5 class="mt-4 border-bottom pb-2 w-100 text-uppercase fw-bold text-secondary">Contato</h5>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase">E-mail</label>
                        <input asp-for="Funcionario.Email" type="email" class="form-control" style="text-transform: lowercase;" maxlength="50" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase">Telefone / Celular</label>
                        <input asp-for="Funcionario.Telefone" class="form-control" maxlength="15" />
                    </div>

                    <h5 class="mt-4 border-bottom pb-2 w-100 text-uppercase fw-bold text-secondary">Endereço</h5>

                    <div class="col-md-3">
                        <label class="form-label fw-bold text-uppercase">CEP</label>
                        <input asp-for="Funcionario.Cep" class="form-control" maxlength="8" />
                    </div>

                    <div class="col-md-7">
                        <label class="form-label fw-bold text-uppercase">Logradouro (Rua, Av.)</label>
                        <input asp-for="Funcionario.Logradouro" class="form-control" style="text-transform: uppercase;" maxlength="50" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold text-uppercase">Número</label>
                        <input asp-for="Funcionario.Numero" class="form-control" maxlength="10" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-uppercase">Complemento</label>
                        <input asp-for="Funcionario.Complemento" class="form-control" style="text-transform: uppercase;" maxlength="50" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-uppercase">Bairro</label>
                        <input asp-for="Funcionario.Bairro" class="form-control" style="text-transform: uppercase;" maxlength="50" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold campo-obrigatorio text-uppercase">Cidade</label>
                        <div class="input-group flex-nowrap">
                            <select asp-for="Funcionario.IdCidade" class="form-select" id="selectCidadePrincipal" required>
                                <option value="">-- Selecione a Cidade --</option>
                                @if (Model.ListaCidades != null)
                                {
                                    foreach (var cidade in Model.ListaCidades)
                                    {
                                        <option value="@cidade.IdCidade">@cidade.Cidade</option>
                                    }
                                }
                            </select>
                            <button class="btn btn-outline-success fw-bold" type="button" data-bs-toggle="modal" data-bs-target="#modalNovaCidade">
                                + Novo
                            </button>
                        </div>
                    </div>

                    <h5 class="mt-4 border-bottom pb-2 w-100 text-uppercase fw-bold text-secondary">Documentos Pessoais</h5>

                    <div class="col-md-4">
                        <label class="form-label fw-bold campo-obrigatorio text-uppercase">CPF</label>
                        <input asp-for="Funcionario.Cpf" class="form-control" required maxlength="11" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-uppercase">RG</label>
                        <input asp-for="Funcionario.Rg" class="form-control" maxlength="10" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-uppercase">Data de Nascimento</label>
                        <input asp-for="Funcionario.DataNascimento" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success px-5 py-2 fw-bold text-uppercase">Salvar Funcionário</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 1: GESTÃO E CADASTRO DE CARGOS           -->
<!-- ============================================== -->
<div class="modal fade" id="modalNovoCargo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-success shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold text-uppercase">Gestão Rápida de Cargos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card shadow-sm border-secondary mb-4">
                    <div class="card-header bg-dark text-white fw-bold text-uppercase">Cargos Cadastrados</div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-striped table-hover mb-0 text-center align-middle" style="font-size: 0.9rem;">
                                <thead style="position: sticky; top: 0; z-index: 1;" class="table-dark">
                                    <tr>
                                        <th>CÓDIGO</th>
                                        <th>CARGO</th>
                                        <th>DESCRIÇÃO</th>
                                        <th>DATA DE INCLUSÃO</th>
                                        <th>ÚLTIMA ALTERAÇÃO</th>
                                        <th>AÇÕES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ListaCargos != null)
                                    {
                                        foreach (var cargo in Model.ListaCargos)
                                        {
                                            <tr id="linha-cargo-@cargo.IdCargo">
                                                <td>@cargo.IdCargo</td>
                                                <td class="fw-bold text-uppercase" id="td-cargo-nome-@cargo.IdCargo">@cargo.Cargo</td>
                                                <td class="fw-bold text-uppercase" id="td-cargo-descricao-@cargo.IdCargo">@cargo.Descricao</td>
                                                <td>@cargo.DataInclusao</td>
                                                <td id="td-cargo-alteracao-@cargo.IdCargo">@cargo.DataAlteracao</td>
                                                <td>
                                                    <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="abrirModalEditarCargo(@cargo.IdCargo, '@cargo.Cargo', '@cargo.Descricao')">EDITAR</button>
                                                    <button type="button" class="btn btn-danger btn-sm fw-bold" onclick="excluirCargoAjax(@cargo.IdCargo)">EXCLUIR</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white fw-bold text-uppercase">+ Novo Cargo</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold campo-obrigatorio text-uppercase">Nome do Cargo</label>
                                <input type="text" id="modalCargoNome" class="form-control" maxlength="50" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-uppercase">Descrição</label>
                                <input type="text" id="modalCargoDescricao" class="form-control" maxlength="100" style="text-transform: uppercase;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success fw-bold" onclick="salvarCargoAjax()">Salvar Cargo</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 2: EDITAR CARGO (Abre por cima)          -->
<!-- ============================================== -->
<div class="modal fade" id="modalEditarCargo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-warning shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold text-uppercase">Editar Cargo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card shadow-sm border-secondary bg-dark text-white rounded">
                    <div class="card-body">
                        <input type="hidden" id="editCargoId" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-uppercase">Cargo</label>
                                <input type="text" id="editCargoNome" class="form-control" maxlength="50" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-uppercase">Descrição</label>
                                <input type="text" id="editCargoDescricao" class="form-control" maxlength="100" style="text-transform: uppercase;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning fw-bold text-dark" onclick="salvarEdicaoCargoAjax()">Salvar Alterações</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 3: GESTÃO E CADASTRO DE CIDADES          -->
<!-- ============================================== -->
<div class="modal fade" id="modalNovaCidade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-success shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold text-uppercase">Gestão Rápida de Cidades</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card shadow-sm border-secondary mb-4">
                    <div class="card-header bg-dark text-white fw-bold text-uppercase">Cidades Cadastradas</div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-striped table-hover mb-0 text-center align-middle" style="font-size: 0.9rem;">
                                <thead style="position: sticky; top: 0; z-index: 1;" class="table-dark">
                                    <tr>
                                        <th>CÓDIGO</th>
                                        <th>CIDADE</th>
                                        <th>ESTADO</th>
                                        <th>DATA DE INCLUSÃO</th>
                                        <th>ÚLTIMA ALTERAÇÃO</th>
                                        <th>AÇÕES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ListaCidades != null)
                                    {
                                        foreach (var cidade in Model.ListaCidades)
                                        {
                                            <tr id="linha-cidade-@cidade.IdCidade">
                                                <td>@cidade.IdCidade</td>
                                                <td class="fw-bold text-uppercase" id="td-cidade-nome-@cidade.IdCidade">@cidade.Cidade</td>
                                                <td class="text-uppercase" id="td-cidade-estado-@cidade.IdCidade">@cidade.NomeEstado</td>
                                                <td>@cidade.DataInclusao</td>
                                                <td id="td-cidade-alteracao-@cidade.IdCidade">@cidade.DataAlteracao</td>
                                                <td>
                                                    <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="abrirModalEditarCidade(@cidade.IdCidade, '@cidade.Cidade', @cidade.IdEstado)">EDITAR</button>
                                                    <button type="button" class="btn btn-danger btn-sm fw-bold" onclick="excluirCidadeAjax(@cidade.IdCidade)">EXCLUIR</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white fw-bold text-uppercase">+ Nova Cidade</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label fw-bold campo-obrigatorio text-uppercase">Cidade</label>
                                <input type="text" id="modalCidadeNome" class="form-control" maxlength="60" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold campo-obrigatorio text-uppercase">Estado</label>
                                <div class="input-group flex-nowrap">
                                    <select class="form-select" id="selectEstadoModalCidade" required>
                                        <option value="">-- Selecione --</option>
                                        @if (Model.ListaEstados != null)
                                        {
                                            foreach (var estado in Model.ListaEstados)
                                            {
                                                <option value="@estado.IdEstado">@estado.Estado - @estado.Uf</option>
                                            }
                                        }
                                    </select>
                                    <button class="btn btn-outline-success fw-bold" type="button" onclick="abrirModalEstadoSobreposto()">+ Novo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success fw-bold" onclick="salvarCidadeAjax()">Salvar Cidade</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 4: EDITAR CIDADE (Abre por cima)         -->
<!-- ============================================== -->
<div class="modal fade" id="modalEditarCidade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-warning shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold text-uppercase">Editar Cidade</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card shadow-sm border-secondary bg-dark text-white rounded">
                    <div class="card-body">
                        <input type="hidden" id="editCidadeId" />
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label fw-bold text-uppercase">Cidade</label>
                                <input type="text" id="editCidadeNome" class="form-control" maxlength="60" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-uppercase">Estado</label>
                                <select class="form-select" id="editCidadeIdEstado" required>
                                    <option value="">-- Selecione --</option>
                                    @if (Model.ListaEstados != null)
                                    {
                                        foreach (var estado in Model.ListaEstados)
                                        {
                                            <option value="@estado.IdEstado">@estado.Estado - @estado.Uf</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning fw-bold text-dark" onclick="salvarEdicaoCidadeAjax()">Salvar Alterações</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 5: GESTÃO E CADASTRO DE ESTADOS          -->
<!-- ============================================== -->
<div class="modal fade" id="modalNovoEstado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-success shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold text-uppercase">Gestão Rápida de Estados</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card shadow-sm border-secondary mb-4">
                    <div class="card-header bg-dark text-white fw-bold text-uppercase">Estados Cadastrados</div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-striped table-hover mb-0 text-center align-middle" style="font-size: 0.9rem;">
                                <thead style="position: sticky; top: 0; z-index: 1;" class="table-dark">
                                    <tr>
                                        <th>CÓDIGO</th>
                                        <th>ESTADO</th>
                                        <th>UF</th>
                                        <th>DATA DE INCLUSÃO</th>
                                        <th>ÚLTIMA ALTERAÇÃO</th>
                                        <th>AÇÕES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ListaEstados != null)
                                    {
                                        foreach (var estado in Model.ListaEstados)
                                        {
                                            <tr id="linha-estado-@estado.IdEstado">
                                                <td>@estado.IdEstado</td>
                                                <td class="fw-bold text-uppercase" id="td-estado-nome-@estado.IdEstado">@estado.Estado</td>
                                                <td class="text-uppercase" id="td-estado-uf-@estado.IdEstado">@estado.Uf</td>
                                                <td>@estado.DataInclusao</td>
                                                <td id="td-estado-alteracao-@estado.IdEstado">@estado.DataAlteracao</td>
                                                <td>
                                                    <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="abrirModalEditarEstado(@estado.IdEstado, '@estado.Estado', '@estado.Uf', @estado.IdPais)">EDITAR</button>
                                                    <button type="button" class="btn btn-danger btn-sm fw-bold" onclick="excluirEstadoAjax(@estado.IdEstado)">EXCLUIR</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white fw-bold text-uppercase">+ Novo Estado</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold campo-obrigatorio text-uppercase">Estado</label>
                                <input type="text" id="modalEstadoNome" class="form-control" maxlength="50" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold campo-obrigatorio text-uppercase">UF</label>
                                <input type="text" id="modalEstadoUf" class="form-control" maxlength="2" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold campo-obrigatorio text-uppercase">País</label>
                                <div class="input-group flex-nowrap">
                                    <select class="form-select" id="selectPaisModalEstado" required>
                                        <option value="">-- Selecione --</option>
                                        @if (Model.ListaPaises != null)
                                        {
                                            foreach (var pais in Model.ListaPaises)
                                            {
                                                <option value="@pais.IdPais">@pais.Pais</option>
                                            }
                                        }
                                    </select>
                                    <button class="btn btn-outline-success fw-bold" type="button" onclick="abrirModalPaisSobreposto()">+ Novo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success fw-bold" onclick="salvarEstadoAjax()">Salvar Estado</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 6: EDITAR ESTADO (Abre por cima)         -->
<!-- ============================================== -->
<div class="modal fade" id="modalEditarEstado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-warning shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold text-uppercase">Editar Estado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card shadow-sm border-secondary bg-dark text-white rounded">
                    <div class="card-body">
                        <input type="hidden" id="editEstadoId" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-uppercase">Estado</label>
                                <input type="text" id="editEstadoNome" class="form-control" maxlength="50" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold text-uppercase">UF</label>
                                <input type="text" id="editEstadoUf" class="form-control" maxlength="2" style="text-transform: uppercase;" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-uppercase">País</label>
                                <select class="form-select" id="editEstadoIdPais" required>
                                    <option value="">-- Selecione --</option>
                                    @if (Model.ListaPaises != null)
                                    {
                                        foreach (var pais in Model.ListaPaises)
                                        {
                                            <option value="@pais.IdPais">@pais.Pais</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
